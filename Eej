local function CreateDropdown(parent, title, icon, actionText, bg, onSelect, onAction)
    local card = CreateCard(parent, 34)
    card.ClipsDescendants = true
    
    local mainBtn = Instance.new("TextButton", card)
    mainBtn.Size, mainBtn.Position, mainBtn.BackgroundTransparency = UDim2.new(1, -45, 0, 34), UDim2.new(0, 10, 0, 0), 1
    mainBtn.Text = title
    mainBtn.TextColor3, mainBtn.Font, mainBtn.TextSize = Theme.TextPrimary, Enum.Font.GothamMedium, 10
    mainBtn.TextXAlignment = Enum.TextXAlignment.Left
    
    local actBtn = icon and CreateCircleBtn(card, icon, bg or Theme.AccentOn, UDim2.new(0, 28, 0, 22), UDim2.new(1, -34, 0, 6))
    
    local listFrame = Instance.new("Frame", card)
    listFrame.Size, listFrame.Position, listFrame.BackgroundTransparency = UDim2.new(1, 0, 1, -34), UDim2.new(0, 0, 0, 34), 1
    Instance.new("UIListLayout", listFrame).SortOrder = Enum.SortOrder.LayoutOrder
    
    local isOpen = false
    local function Refresh()
        for _, c in pairs(listFrame:GetChildren()) do if c:IsA("Frame") then c:Destroy() end end
        
        local resetItem = Instance.new("Frame", listFrame)
        resetItem.Size, resetItem.BackgroundTransparency = UDim2.new(1, 0, 0, 28), 1
        local resetLbl = Instance.new("TextLabel", resetItem)
        resetLbl.Size, resetLbl.Position, resetLbl.BackgroundTransparency = UDim2.new(1, -45, 1, 0), UDim2.new(0, 10, 0, 0), 1
        resetLbl.Text = "[ยกเลิก / ไม่เลือก]"
        resetLbl.TextColor3, resetLbl.Font, resetLbl.TextSize = Theme.AccentOn, Enum.Font.GothamBold, 10
        resetLbl.TextXAlignment = Enum.TextXAlignment.Left
        
        local resetSel = CreateCircleBtn(resetItem, "ล้าง", Theme.AccentOff, UDim2.new(0, 32, 0, 20), UDim2.new(1, -38, 0.5, -10))
        resetSel.TextSize = 8
        resetSel.MouseButton1Click:Connect(function()
            onSelect(nil, mainBtn)
            isOpen = false
            card.Size = UDim2.new(1, -6, 0, 34)
        end)

        local count = 1
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                count = count + 1
                local item = Instance.new("Frame", listFrame)
                item.Size, item.BackgroundTransparency = UDim2.new(1, 0, 0, 28), 1
                
                local lbl = Instance.new("TextLabel", item)
                lbl.Size, lbl.Position, lbl.BackgroundTransparency = UDim2.new(1, -45, 1, 0), UDim2.new(0, 10, 0, 0), 1
                lbl.Text = p.DisplayName .. " (@" .. p.Name .. ")"
                lbl.TextColor3, lbl.Font, lbl.TextSize = Theme.TextSecondary, Enum.Font.Gotham, 10
                lbl.TextXAlignment = Enum.TextXAlignment.Left
                
                local sel = CreateCircleBtn(item, actionText or "เลือก", bg or Theme.AccentOn, UDim2.new(0, 32, 0, 20), UDim2.new(1, -38, 0.5, -10))
                sel.TextSize = 8
                sel.MouseButton1Click:Connect(function()
                    onSelect(p, mainBtn)
                    isOpen = false
                    card.Size = UDim2.new(1, -6, 0, 34)
                end)
            end
        end
        if isOpen then card.Size = UDim2.new(1, -6, 0, 34 + (count * 28)) end
    end
    
    mainBtn.MouseButton1Click:Connect(function()
        isOpen = not isOpen
        if isOpen then Refresh() else card.Size = UDim2.new(1, -6, 0, 34) end
    end)
    
    if actBtn and onAction then actBtn.MouseButton1Click:Connect(onAction) end
    return Refresh, function() return isOpen end
end

