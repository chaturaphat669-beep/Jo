local function OneClickKillRole()
    local myRole = DetectPlayerRole(LocalPlayer)
    local myChar = LocalPlayer.Character
    local myHRP = GetHRP(LocalPlayer)
    if not myChar or not myHRP then return end

    if myRole == "ไอชั่ว" then
        local knife = nil
        for _, tool in pairs(LocalPlayer.Backpack:GetChildren()) do
            if tool:IsA("Tool") then
                local name = tool.Name:lower()
                if name:find("knife") or name:find("blade") or name:find("sword") or name:find("dagger") or name:find("มีด") or name:find("ขวาน") then
                    knife = tool
                    break
                end
            end
        end
        if not knife and myChar:FindFirstChildOfClass("Tool") then
            knife = myChar:FindFirstChildOfClass("Tool")
        end

        if knife then
            knife.Parent = myChar
            local handle = knife:FindFirstChild("Handle") or knife:FindFirstChild("Blade") or knife:FindFirstChildOfClass("BasePart")
            local origCF = myHRP.CFrame

            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    local tHRP = GetHRP(p)
                    local tHum = GetHum(p)
                    if tHRP and tHum and tHum.Health > 0 then
                        if typeof(firetouchinterest) == "function" and handle then
                            pcall(function()
                                firetouchinterest(tHRP, handle, 0)
                                firetouchinterest(tHRP, handle, 1)
                            end)
                        else
                            myHRP.CFrame = tHRP.CFrame * CFrame.new(0, 0, 1)
                            task.wait(0.02)
                            if knife:FindFirstChild("Activate") or knife:IsA("Tool") then knife:Activate() end
                        end
                    end
                end
            end
            task.wait(0.05)
            myHRP.CFrame = origCF
        end

    elseif myRole == "ฮีโร่" then
        local gun = nil
        for _, tool in pairs(LocalPlayer.Backpack:GetChildren()) do
            if tool:IsA("Tool") then
                local name = tool.Name:lower()
                if name:find("gun") or name:find("revolver") or name:find("pistol") or name:find("sheriff") or name:find("ปืน") or name:find("bow") then
                    gun = tool
                    break
                end
            end
        end
        if not gun then
            for _, tool in pairs(myChar:GetChildren()) do
                if tool:IsA("Tool") then
                    local name = tool.Name:lower()
                    if name:find("gun") or name:find("revolver") or name:find("pistol") or name:find("sheriff") or name:find("ปืน") or name:find("bow") then
                        gun = tool
                        break
                    end
                end
            end
        end

        if gun then
            gun.Parent = myChar
            local murderPlr = nil
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer then
                    local roleName = DetectPlayerRole(p)
                    if roleName == "ไอชั่ว" then
                        murderPlr = p
                        break
                    end
                end
            end

            if murderPlr and murderPlr.Character then
                local tHRP = GetHRP(murderPlr)
                local tHead = murderPlr.Character:FindFirstChild("Head")
                local handle = gun:FindFirstChild("Handle") or gun:FindFirstChildOfClass("BasePart")
                local origCF = myHRP.CFrame

                if tHRP then
                    local shootRemote = gun:FindFirstChild("Shoot") or gun:FindFirstChild("KnifeServer") or game:GetService("ReplicatedStorage"):FindFirstChild("ShootGun", true)
                    
                    if typeof(firetouchinterest) == "function" and handle then
                        pcall(function()
                            firetouchinterest(tHRP, handle, 0)
                            firetouchinterest(tHRP, handle, 1)
                        end)
                    end

                    myHRP.CFrame = CFrame.new(tHRP.Position - (tHRP.CFrame.LookVector * 3), tHRP.Position)
                    task.wait(0.04)
                    if gun:FindFirstChild("Activate") or gun:IsA("Tool") then
                        gun:Activate()
                    end
                    
                    if shootRemote and shootRemote:IsA("RemoteEvent") then
                        pcall(function()
                            shootRemote:FireServer(tHRP.Position, (tHead or tHRP).Position)
                        end)
                    end

                    task.wait(0.05)
                    myHRP.CFrame = origCF
                end
            end
        end
    end
end

