    btn.Text = p and ("👻 ข้างหลัง: " .. p.DisplayName) or "👻 อยู่ข้างหลังเป้าหมาย 🔻"
end, function()
    local target = GetTarget(BehindTarget)
    local myHRP, targetHRP = GetHRP(LocalPlayer), GetHRP(target)
    if myHRP and targetHRP then
        local origCF = myHRP.CFrame
        myHRP.CFrame = targetHRP.CFrame * CFrame.new(0, 0, 3)
        task.wait(BehindStayTime)
        myHRP.CFrame = origCF
    end
end)

-- ปรับแต่งช่วงเวลา: 0.01 - 1000000000000000 (1e15) วินาที
CreateInputWithCircleBtn(TabTroll, "⏱️ เวลา Fling (0.01 - 1e15 วิ)", "⏱️", function(t)
    local n = tonumber(t)
    if n then FlingTime = math.clamp(n, 0.01, 1e15) end
end)

CreateDropdown(TabTroll, "💥 Fling เป้าหมาย 🔻", "🚀", "เลือก", Theme.ButtonRed, function(p, btn)
    FlingTarget = p
    btn.Text = p and ("💥 Fling: " .. p.DisplayName) or "💥 Fling เป้าหมาย 🔻"
end, function()
    local target = GetTarget(FlingTarget)
    local myHRP, targetHRP = GetHRP(LocalPlayer), GetHRP(target)
    if myHRP and targetHRP then
        local origCF = myHRP.CFrame
        local bvf = Instance.new("BodyAngularVelocity")
        bvf.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        bvf.AngularVelocity = Vector3.new(0, 99999, 0)
        bvf.Parent = myHRP

        local startTime = tick()
        while tick() - startTime < FlingTime do
            if not targetHRP or not targetHRP.Parent then break end
            myHRP.CFrame = targetHRP.CFrame * CFrame.new(math.random(-1, 1), 0, math.random(-1, 1))
            myHRP.Velocity = Vector3.new(0, 100, 0)
            RunService.Heartbeat:Wait()
        end

        bvf:Destroy()
        myHRP.CFrame = origCF
        myHRP.Velocity = Vector3.zero
    end
end)

