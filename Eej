local function ParseColorInput(t, defaultColor)
    local r, g, b = t:match("(%d+)[,%s]+(%d+)[,%s]+(%d+)")
    if r and g and b then
        return Color3.fromRGB(math.clamp(tonumber(r), 0, 255), math.clamp(tonumber(g), 0, 255), math.clamp(tonumber(b), 0, 255))
    else
        local lower = t:lower()
        if lower == "red" or lower == "แดง" then return Color3.fromRGB(255, 60, 60)
        elseif lower == "green" or lower == "เขียว" then return Color3.fromRGB(50, 255, 80)
        elseif lower == "blue" or lower == "ฟ้า" or lower == "น้ำเงิน" then return Color3.fromRGB(60, 160, 255)
        elseif lower == "yellow" or lower == "เหลือง" then return Color3.fromRGB(255, 220, 0)
        elseif lower == "purple" or lower == "ม่วง" then return Color3.fromRGB(190, 80, 255)
        elseif lower == "white" or lower == "ขาว" then return Color3.fromRGB(255, 255, 255)
        elseif lower == "orange" or lower == "ส้ม" then return Color3.fromRGB(255, 140, 0)
        elseif lower == "cyan" or lower == "ฟ้าอ่อน" then return Color3.fromRGB(0, 255, 255)
        end
    end
    return defaultColor
end

local function DetectPlayerRole(p)
    if not p then return "คนดี", InnocentColor end
    local char = p.Character
    local backpack = p:FindFirstChild("Backpack")
    
    local hasKnife = false
    local hasGun = false

    local function CheckTool(tool)
        if tool and tool:IsA("Tool") then
            local name = tool.Name:lower()
            if name:find("knife") or name:find("blade") or name:find("sword") or name:find("dagger") or name:find("มีด") or name:find("ขวาน") then
                hasKnife = true
            elseif name:find("gun") or name:find("revolver") or name:find("pistol") or name:find("sheriff") or name:find("ปืน") or name:find("bow") then
                hasGun = true
            end
        end
    end

    if backpack then
        for _, tool in pairs(backpack:GetChildren()) do CheckTool(tool) end
    end
    if char then
        for _, tool in pairs(char:GetChildren()) do CheckTool(tool) end
    end

    local roleVal = p:FindFirstChild("Role") or (char and char:FindFirstChild("Role"))
    local roleStr = roleVal and tostring(roleVal.Value):lower() or ""
    local teamStr = p.Team and p.Team.Name:lower() or ""

    if hasKnife or roleStr:find("murder") or teamStr:find("murder") or roleStr:find("killer") then
        return "ไอชั่ว", MurderColor
    elseif hasGun or roleStr:find("sheriff") or roleStr:find("hero") or teamStr:find("sheriff") or teamStr:find("hero") or roleStr:find("police") then
        return "ฮีโร่", HeroColor
    else
        return "คนดี", InnocentColor
    end
end

local function TeleportToDroppedGun()
    local myHRP = GetHRP(LocalPlayer)
    if not myHRP then return end

    local targetPart = nil

    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Tool") then
            local name = obj.Name:lower()
            if name:find("gun") or name:find("revolver") or name:find("pistol") or name:find("sheriff") or name:find("bow") or name:find("ปืน") or name:find("weapon") then
                local isHeld = false
                for _, p in pairs(Players:GetPlayers()) do
                    if (p.Character and obj:IsDescendantOf(p.Character)) or (p:FindFirstChild("Backpack") and obj:IsDescendantOf(p.Backpack)) then
                        isHeld = true
                        break
                    end
                end
                if not isHeld then
                    targetPart = obj:FindFirstChild("Handle") or obj:FindFirstChildOfClass("BasePart")
                    if targetPart then break end
                end
            end
        elseif obj:IsA("BasePart") then
            local name = obj.Name:lower()
            if name == "gun" or name == "gundrop" or name == "revolver" or name == "sheriff" or name == "gunpart" then
                targetPart = obj
                break
            end
        end
    end

    if targetPart then
        local originalCFrame = myHRP.CFrame
        myHRP.CFrame = targetPart.CFrame + Vector3.new(0, 0.5, 0)
        
        if typeof(firetouchinterest) == "function" then
            pcall(function()
                firetouchinterest(myHRP, targetPart, 0)
                task.wait(0.01)
                firetouchinterest(myHRP, targetPart, 1)
            end)
        else
            task.wait(0.01)
        end

        myHRP.CFrame = originalCFrame
    end
end

