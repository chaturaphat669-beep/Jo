CreateToggleButton(TabTroll, "🌐 เปิด/ปิด Orbit โคจรรอบเป้าหมาย", function(e)
    OrbitEnabled = e
    if OrbitEnabled then
        CleanConnection("Orbit")
        Connections["Orbit"] = RunService.RenderStepped:Connect(function(dt)
            local target = GetTarget(OrbitTarget)
            local myHRP, targetHRP = GetHRP(LocalPlayer), GetHRP(target)
            if myHRP and targetHRP then
                OrbitAngle = OrbitAngle + (dt * OrbitSpeed)
                local offset = Vector3.new(math.cos(OrbitAngle) * OrbitDistance, 0, math.sin(OrbitAngle) * OrbitDistance)
                myHRP.CFrame = CFrame.new(targetHRP.Position + offset, targetHRP.Position)
            end
        end)
    else
        CleanConnection("Orbit")
    end
end)

