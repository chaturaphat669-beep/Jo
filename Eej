CreateToggleButton(TabSafe, "🛡️ 1. ระบบกันตกแมพ (Anti-Void)", function(e)
    AntiVoidEnabled = e
    if AntiVoidEnabled then
        CleanConnection("AntiVoid")
        Connections["AntiVoid"] = RunService.Heartbeat:Connect(function()
            local myHRP = GetHRP(LocalPlayer)
            if myHRP then
                if myHRP.Position.Y > -50 then
                    LastSafeCF = myHRP.CFrame
                elseif myHRP.Position.Y <= -100 and LastSafeCF then
                    myHRP.CFrame = LastSafeCF + Vector3.new(0, 5, 0)
                    myHRP.Velocity = Vector3.zero
                end
            end
        end)
    else
        CleanConnection("AntiVoid")
    end
end)

CreateToggleButton(TabSafe, "⚡ 2. ลดความแลค / เพิ่ม FPS (Anti-Lag Booster)", function(e)
    AntiLagEnabled = e
    if AntiLagEnabled then
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("ParticleEmitter") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") then
                if obj.Enabled then
                    table.insert(DisabledParticles, obj)
                    obj.Enabled = false
                end
            elseif obj:IsA("BasePart") and not (LocalPlayer.Character and obj:IsDescendantOf(LocalPlayer.Character)) then
                obj.Material = Enum.Material.SmoothPlastic
            end
        end
        Lighting.GlobalShadows = false
    else
        for _, obj in pairs(DisabledParticles) do
            if obj and obj.Parent then obj.Enabled = true end
        end
        DisabledParticles = {}
        Lighting.GlobalShadows = OldLighting.GlobalShadows
    end
end)

